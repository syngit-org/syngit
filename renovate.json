{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": ["config/**", "charts/**", "Dockerfile.cross"],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "description": "One PR for all workflow action bumps: the pins are SHAs, so an ungrouped run opens a PR per action",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "The SLSA generator verifies its own ref to build provenance and refuses to run from a commit SHA, so it has to stay on a semver tag",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["slsa-framework/slsa-github-generator"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions pinned in the Makefile and in Go constants annotated with a renovate comment",
      "managerFilePatterns": ["/(^|/)Makefile$/", "/\\.go$/"],
      "matchStrings": [
        "(#|//)\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+versioning=(?<versioning>\\S+))?(\\s+extractVersion=(?<extractVersion>\\S+))?[^\\n]*\\n[^\\n=]*?=\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ]
}
